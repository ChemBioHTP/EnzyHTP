# this script needs to be sourced
(return 0 2>/dev/null)
if [ $? -ne 0 ]; then
    echo "⚠️  Please run this script using: source ${BASH_SOURCE[0]}"
    echo "Do NOT run it as ./${BASH_SOURCE[0]} or bash ${BASH_SOURCE[0]}"
    exit 1
fi

# Store the initial working directory
initial_dir=$(pwd)

# Change the working directory to the parent directory of this script
cd "$(dirname "${BASH_SOURCE[0]}")"/..

# Set a default environment name
target_env_name=$CONDA_DEFAULT_ENV

# Function to display help message
show_help() {
    echo "Usage: source ${0##*/} [-n|--name ENV_NAME]"
    echo
    echo "Install EnzyHTP to your conda environment."
    echo
    echo "   -n, --name    Specify the name of the conda environment. Defaults to current environment."
    echo "   -h, --help    Display this help and exit."
}

# Define the options
OPTS=$(getopt -o hn: --long help,name: -- "$@")

# Exit if the options have not been correctly specified.
if [ $? != 0 ]; then return; fi

# Extract options and their arguments into variables.
eval set -- "$OPTS"

while true; do
    case "$1" in
        -h|--help)
            show_help
            return;;
        -n|--name)
            target_env_name="$2"; shift 2;;
        --)
            shift; break;;
        *)
            break;;
    esac
done

# Get the conda version
CONDA_VERSION=$(conda --version | cut -d' ' -f2)
echo "Conda Version: $CONDA_VERSION"

# Remove the build directory if it exists
if [[ -d build ]]; then
    rm -r build;
fi

# Function to activate the conda environment
activate_env() {
    echo "Activating environment..."
    conda activate "$target_env_name"
}

# Function for yes/no prompt, called when the target environment is 'base'.
prompt_yes_no() {
    while true; do
        read -p "$1 (yes/no): " yn
        case $yn in
            [Yy]* ) break;;
            [Nn]* ) echo "Aborting installation..."; return 1;;
            * ) echo "Please answer yes or no.";;
        esac
    done
}

# Function to check if the environment exists and create it if not
check_and_create_env() {
    if ! conda env list | awk '{print $1}' | grep -Fx "$target_env_name" > /dev/null; then
        echo "Environment $target_env_name does not exist. Creating..."
        conda create -n "$target_env_name" python=3.9 --yes
    else
        echo "Environment $target_env_name exists."
    fi
}

check_solver() {
    local s
    s=$(conda config --show solver 2>/dev/null | awk '/^solver:/ {print $2}') || s=""
    if [[ "$s" != "libmamba" ]]; then
        echo "⚠️  Current conda solver is '$s' (expected: libmamba)."
        echo "⚠️  libmamba has been the default solver in conda since version 23.10 (2023/11)"
        echo "⚠️  You see this message either mean you have a deprecated conda or changed the default solver before."
        echo "    Please enable libmamba first:"
        echo "    If you have an old conda, run:"
        echo "        conda update -n base -c defaults conda"
        echo "    If you changed the solver config, run:"
        echo "        conda config --set solver libmamba"
        return 1
    fi
}

# Function to update the conda environment
update_env() {
    echo "Updating conda environment: $target_env_name"
    conda activate "$target_env_name"

    check_solver || return 1

    conda env update -n "$target_env_name" --file environment.yml

    # Run post-install hook
    dev-tools/pip-install
}

# Check current conda environment and extract environment name.
current_env_path=$(conda info --json | grep "\"default_prefix\":" | awk '{print $2}' | tr -d '",')
current_env_name=$(basename "$current_env_path")

echo "Installing EnzyHTP to Conda environment: $target_env_name"


# Check if the user is about to install in the base environment
if [[ "$target_env_name" == "base" ]]; then
    prompt_yes_no "We DO NOT recommend installing EnzyHTP in the base environment. Are you sure you want to continue?" || return 1
fi

# Compare current environment with env_name
if [ "$current_env_name" = "$target_env_name" ]; then
    update_env || return 1
else
    # Check, create, and activate environment if necessary.
    check_and_create_env

    # After checking, perform update.
    update_env || return 1
    conda deactivate
fi

cd "$initial_dir"
